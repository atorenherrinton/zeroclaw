+
+// A failed native query returns no rows as well as an error. Preserve that
+// error before interpreting an empty successful query as a missing item.
+func keychainQueryError(err error, count int) error {
+	if err == gokeychain.ErrorItemNotFound {
+		return ErrKeyNotFound
+	}
+	if err != nil {
+		return err
+	}
+	if count == 0 {
+		return ErrKeyNotFound
+	}
+	return nil
+}
--- /dev/null
+++ b/keychain_query_error_test.go
@@ -0,0 +1,26 @@
+//go:build darwin && cgo
+
+package keyring
+
+import (
+	"errors"
+	gokeychain "github.com/99designs/go-keychain"
+	"testing"
+)
+
+func TestKeychainQueryError(t *testing.T) {
+	for _, status := range []gokeychain.Error{-25308, -25293, -128, -50} {
+		if got := keychainQueryError(status, 0); got != status || errors.Is(got, ErrKeyNotFound) {
+			t.Fatalf("native error %v became %v", status, got)
+		}
+	}
+	if got := keychainQueryError(gokeychain.ErrorItemNotFound, 0); got != ErrKeyNotFound {
+		t.Fatal(got)
+	}
+	if got := keychainQueryError(nil, 0); got != ErrKeyNotFound {
+		t.Fatal(got)
+	}
+	if got := keychainQueryError(nil, 1); got != nil {
+		t.Fatal(got)
+	}
+}
