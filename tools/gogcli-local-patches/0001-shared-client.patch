@@ -0,0 +1,20 @@
+//go:build darwin && cgo
+
+package secrets
+
+/*
+#cgo LDFLAGS: -framework Security
+#include <Security/Security.h>
+*/
+import "C"
+
+import "fmt"
+
+// SuppressKeychainPrompts makes unattended requests fail closed instead of
+// leaving native password dialogs behind after their caller times out.
+func SuppressKeychainPrompts() error {
+	if status := C.SecKeychainSetUserInteractionAllowed(C.Boolean(0)); status != 0 {
+		return fmt.Errorf("disable background Keychain dialogs: OSStatus %d", int(status))
+	}
+	return nil
+}
