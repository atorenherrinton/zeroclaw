+
+// PersistAccessTokenCache reports whether short-lived OAuth tokens may be written
+// to this store. Updating legacy macOS Keychain data resets its partition ACL,
+// removing the other approved executables from the shared credential.
+func (s *KeyringStore) PersistAccessTokenCache() bool {
+	return !s.memoryOnlyAccessTokens
 }
 
