index 00000000..a61e0591
--- /dev/null
+++ b/internal/googleapi/client_keychain_cache_test.go
@@ -0,0 +1,71 @@
+package googleapi
+
+import (
+	"testing"
+	"time"
+
+	"github.com/openclaw/gogcli/internal/config"
+	"github.com/openclaw/gogcli/internal/secrets"
+	"golang.org/x/oauth2"
+)
+
+type memoryCacheStore struct{ stubStore }
+
+func (*memoryCacheStore) PersistAccessTokenCache() bool { return false }
+
+func TestKeychainAccessTokenRefreshDoesNotRewriteCredential(t *testing.T) {
+	stored := secrets.Token{Client: config.DefaultClientName, Email: "test@example.com", RefreshToken: "refresh"}
+	store := &memoryCacheStore{stubStore: stubStore{tok: stored}}
+	n := 0
+	base := tokenSourceFunc(func() (*oauth2.Token, error) {
+		n++
+		return &oauth2.Token{AccessToken: "new-access", RefreshToken: "refresh", Expiry: time.Unix(int64(n*3600), 0)}, nil
+	})
+	source := newPersistingTokenSource(base, store, config.DefaultClientName, stored.Email, stored, "", nil)
+	for range 3 {
+		token, err := source.Token()
+		if err != nil || token.AccessToken != "new-access" {
+			t.Fatalf("refresh failed: %v", err)
+		}
+	}
+	if store.setCalls != 0 {
+		t.Fatalf("access-token refresh rewrote credential %d times", store.setCalls)
+	}
+	if source.(*persistingTokenSource).tok.AccessToken != "new-access" {
+		t.Fatal("in-memory token did not advance")
+	}
+}
+
+func TestKeychainCachePolicyPreservesDurableChanges(t *testing.T) {
+	for _, kind := range []string{"refresh rotation", "scope change"} {
+		t.Run(kind, func(t *testing.T) {
+			stored := secrets.Token{Client: config.DefaultClientName, Email: "test@example.com", RefreshToken: "refresh", Scopes: []string{"old"}}
+			store := &memoryCacheStore{stubStore: stubStore{tok: stored}}
+			token := &oauth2.Token{AccessToken: "new-access", RefreshToken: "refresh"}
+			if kind == "refresh rotation" {
+				token.RefreshToken = "rotated"
+			} else {
+				token = token.WithExtra(map[string]any{"scope": "old new"})
+			}
+			source := newPersistingTokenSource(oauth2.StaticTokenSource(token), store, config.DefaultClientName, stored.Email, stored, "", nil)
+			if _, err := source.Token(); err != nil {
+				t.Fatal(err)
+			}
+			if store.setCalls != 1 {
+				t.Fatalf("durable change saved %d times", store.setCalls)
+			}
+			if kind == "refresh rotation" && store.lastSet.RefreshToken != "rotated" {
+				t.Fatal("rotated refresh token lost")
+			}
+			if kind == "scope change" && len(store.lastSet.Scopes) != 2 {
+				t.Fatal("new granted scope lost")
+			}
+			if _, err := source.Token(); err != nil {
+				t.Fatal(err)
+			}
+			if store.setCalls != 1 {
+				t.Fatal("unchanged durable metadata saved again")
+			}
+		})
+	}
+}
