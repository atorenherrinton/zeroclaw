@@ -0,0 +1,30 @@
+package secrets
+
+import (
+	"github.com/99designs/keyring"
+	"github.com/openclaw/gogcli/internal/config"
+	"testing"
+)
+
+func TestOpenAccessTokenCachePolicy(t *testing.T) {
+	for _, tc := range []struct {
+		name, goos, backend string
+		want                bool
+	}{
+		{"macOS keychain", "darwin", "keychain", false},
+		{"macOS auto", "darwin", "auto", false},
+		{"macOS file", "darwin", "file", true},
+		{"Linux file", "linux", "file", true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			layout := config.Layout{ConfigDir: t.TempDir(), DataDir: t.TempDir()}
+			repository, err := Open(OpenOptions{Layout: layout, Config: config.NewConfigStore(layout), GOOS: tc.goos, Backend: tc.backend, KeychainTrustApplication: "false", openKeyringFn: func(keyring.Config) (keyring.Keyring, error) { return keyring.NewArrayKeyring(nil), nil }})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if got := repository.(*KeyringStore).PersistAccessTokenCache(); got != tc.want {
+				t.Fatalf("cache policy = %v; want %v", got, tc.want)
+			}
+		})
+	}
+}
