--- /dev/null
+++ b/internal/errfmt/keychain_darwin.go
@@ -0,0 +1,17 @@
+//go:build darwin && cgo
+
+package errfmt
+
+import (
+	"errors"
+	keychain "github.com/99designs/go-keychain"
+)
+
+func isKeychainAccessDenied(err error) bool {
+	var status keychain.Error
+	if !errors.As(err, &status) {
+		return false
+	}
+	// errSecInteractionNotAllowed, errSecAuthFailed, errSecUserCanceled.
+	return status == keychain.Error(-25308) || status == keychain.Error(-25293) || status == keychain.Error(-128)
+}
