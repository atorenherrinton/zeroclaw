+//go:build darwin && cgo
+
+package errfmt
+
+import (
+	"fmt"
+	keychain "github.com/99designs/go-keychain"
+	"github.com/99designs/keyring"
+	"strings"
+	"testing"
+)
+
+func TestKeychainDenialDoesNotRecommendReauthorization(t *testing.T) {
+	for _, status := range []keychain.Error{-25308, -25293, -128} {
+		message := Format(fmt.Errorf("read Google credential: %w", status))
+		if !strings.Contains(message, "Keychain access is blocked") || strings.Contains(message, "Run: gog auth add") {
+			t.Fatalf("misleading message: %s", message)
+		}
+	}
+	if message := Format(keyring.ErrKeyNotFound); !strings.Contains(message, "Secret not found") {
+		t.Fatalf("genuine missing record changed: %s", message)
+	}
+}
