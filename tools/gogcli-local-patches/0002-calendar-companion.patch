+// The real raw client, OAuth transport and retry transport run against loopback
+// TLS only. No credentials, Google API calls, or exported tokens are involved.
+func TestAPICallCalendarPatchPreconditionAndSingleAttempt(t *testing.T) {
+	for _, status := range []int{200, 403, 412, 429, 503, 307, 308, 0} {
+		t.Run(fmt.Sprint(status), func(t *testing.T) {
+			var patches atomic.Int32
+			const body = `{"summary":"Changed","description":"","location":"  retain whitespace  ","attendees":[]}`
+			server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				if r.Method == http.MethodGet {
+					_, _ = fmt.Fprint(w, `{"rootUrl":"https://www.googleapis.com/","servicePath":"calendar/v3/","resources":{"events":{"methods":{"patch":{"id":"calendar.events.patch","httpMethod":"PATCH","path":"calendars/{calendarId}/events/{eventId}","parameters":{"calendarId":{"location":"path","required":true,"type":"string"},"eventId":{"location":"path","required":true,"type":"string"},"sendUpdates":{"location":"query","type":"string"}},"scopes":["https://www.googleapis.com/auth/calendar.events"]}}}}}`)
+					return
+				}
+				patches.Add(1)
+				if r.Method != http.MethodPatch || r.URL.Path != "/calendar/v3/calendars/exact#id@example.com/events/synthetic123" {
+					t.Errorf("unexpected target: %s %s", r.Method, r.URL.Path)
+				}
+				if r.Header.Get("If-Match") != `"version-1"` {
+					t.Error("missing exact ETag precondition")
+				}
+				if r.URL.Query().Get("sendUpdates") != "none" {
+					t.Error("missing explicit sendUpdates=none")
+				}
+				raw, err := io.ReadAll(r.Body)
+				if err != nil {
+					t.Error(err)
+				}
+				if string(raw) != body {
+					t.Errorf("body changed: %s", raw)
+				}
+				if status == 0 {
+					conn, _, err := w.(http.Hijacker).Hijack()
+					if err != nil {
+						t.Error(err)
+						return
+					}
+					_ = conn.Close()
+					return
+				}
+				w.Header().Set("Retry-After", "0")
+				if status == 307 || status == 308 {
+					w.Header().Set("Location", "https://www.googleapis.com/calendar/v3/calendars/exact%23id@example.com/events/synthetic123")
+				}
+				w.WriteHeader(status)
+				if status == 200 {
+					_, _ = fmt.Fprint(w, `{"id":"synthetic123","etag":"\"version-2\""}`)
+				} else {
+					_, _ = fmt.Fprintf(w, `{"error":{"code":%d,"message":"insufficient authentication scopes"}}`, status)
+				}
+			}))
+			defer server.Close()
+			transport := server.Client().Transport.(*http.Transport).Clone()
+			transport.TLSClientConfig.ServerName = "127.0.0.1"
+			transport.Proxy = nil
+			transport.DialContext = func(ctx context.Context, network, _ string) (net.Conn, error) {
+				return (&net.Dialer{}).DialContext(ctx, network, server.Listener.Addr().String())
+			}
+			original := http.DefaultTransport
+			http.DefaultTransport = transport
+			defer func() { http.DefaultTransport = original; transport.CloseIdleConnections() }()
+			t.Setenv("GOG_DISCOVERY_BASE_URL", "https://www.googleapis.com/discovery/v1")
+			var stdout bytes.Buffer
+			ctx := newCmdRuntimeJSONOutputContext(t, &stdout, &bytes.Buffer{})
+			ctx = authclient.WithAccessToken(ctx, "synthetic-not-a-real-token")
+			cmd := &APICallCmd{}
+			err := runKong(t, cmd, []string{"calendar", "v3", "calendar.events.patch", "--params", `{"calendarId":"exact#id@example.com","eventId":"synthetic123","sendUpdates":"none"}`, "--body", body, "--allow-write", "--single-attempt", "--if-match", `"version-1"`}, ctx, &RootFlags{Account: "synthetic@example.com", Force: true, NoInput: true, EnableCommandsExact: "api.call,api.calendar.events.patch", GmailNoSend: true})
+			if patches.Load() != 1 {
+				t.Fatalf("expected one PATCH, got %d; error=%v", patches.Load(), err)
+			}
+			if status == 200 {
+				if err != nil {
+					t.Fatal(err)
+				}
+				if !strings.Contains(stdout.String(), "version-2") {
+					t.Fatalf("missing receipt: %s", stdout.String())
+				}
+			} else if err == nil {
+				t.Fatalf("status %d must fail without replay", status)
+			}
+		})
+	}
+}
