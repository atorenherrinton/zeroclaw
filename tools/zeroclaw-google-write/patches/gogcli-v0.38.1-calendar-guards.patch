@@ -0,0 +1,90 @@
+package cmd
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"sync/atomic"
+	"testing"
+
+	"google.golang.org/api/calendar/v3"
+	"google.golang.org/api/option"
+
+	"github.com/openclaw/gogcli/internal/googleapi"
+)
+
+// Exercise the actual command and Google API client through the production
+// retry transport. The only server is a local mock, with no Google credentials.
+func TestCalendarCreateCmd_InsertSingleAttempt(t *testing.T) {
+	for _, status := range []int{http.StatusServiceUnavailable, http.StatusTooManyRequests, http.StatusForbidden} {
+		t.Run(fmt.Sprint(status), func(t *testing.T) {
+			var inserts, refreshes atomic.Int32
+			srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				path := strings.TrimPrefix(r.URL.Path, "/calendar/v3")
+				if r.Method != http.MethodPost || path != "/calendars/cal@example.com/events" {
+					t.Errorf("unexpected request: %s %s", r.Method, path)
+					http.NotFound(w, r)
+					return
+				}
+				inserts.Add(1)
+				if r.URL.Query().Get("sendUpdates") != "all" {
+					t.Error("missing sendUpdates=all")
+				}
+				var event map[string]json.RawMessage
+				if err := json.NewDecoder(r.Body).Decode(&event); err != nil {
+					t.Errorf("decode event: %v", err)
+				}
+				var attendees []*calendar.EventAttendee
+				if err := json.Unmarshal(event["attendees"], &attendees); err != nil {
+					t.Errorf("decode attendees: %v", err)
+				}
+				if len(attendees) != 1 || attendees[0].Email != "invitee@example.com" {
+					t.Errorf("unexpected attendees: %+v", attendees)
+				}
+				for _, field := range []string{"guestsCanInviteOthers", "guestsCanModify"} {
+					if string(event[field]) != "false" {
+						t.Errorf("%s must explicitly be false, got %s", field, event[field])
+					}
+				}
+				w.Header().Set("Content-Type", "application/json")
+				w.Header().Set("Retry-After", "0")
+				w.WriteHeader(status)
+				_, _ = fmt.Fprintf(w, `{"error":{"code":%d,"message":"insufficient authentication scopes"}}`, status)
+			}))
+			defer srv.Close()
+
+			retry := googleapi.NewRetryTransport(srv.Client().Transport)
+			retry.BaseDelay = 0
+			retry.RefreshAuth = func(context.Context) error {
+				refreshes.Add(1)
+				return nil
+			}
+			svc, err := calendar.NewService(context.Background(),
+				option.WithoutAuthentication(),
+				option.WithHTTPClient(&http.Client{Transport: retry}),
+				option.WithEndpoint(srv.URL+"/"),
+			)
+			if err != nil {
+				t.Fatal(err)
+			}
+			ctx := withCalendarTestService(newCmdRuntimeJSONOutputContext(t, io.Discard, io.Discard), svc)
+			cmd := &CalendarCreateCmd{}
+			err = runKong(t, cmd, []string{
+				"cal@example.com", "--summary", "Synthetic invitation",
+				"--from", "2030-01-01T10:00:00Z", "--to", "2030-01-01T11:00:00Z",
+				"--attendees", "invitee@example.com", "--send-updates", "all",
+				"--guests-can-invite=false", "--guests-can-modify=false",
+			}, ctx, &RootFlags{Account: "owner@example.com"})
+			if err == nil {
+				t.Fatal("insert error must propagate")
+			}
+			if inserts.Load() != 1 || refreshes.Load() != 0 {
+				t.Fatalf("insert was retried: inserts=%d refreshes=%d", inserts.Load(), refreshes.Load())
+			}
+		})
+	}
+}
